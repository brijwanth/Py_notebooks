{
  "title": "OneView",
  "csv": "oneview.csv",
  "output": "oneview.html",
  "title_property": "Symbol Name",
  "board": {
    "group_by": "Kanban Status"
  },
  "calendar": {
    "date_property": "Result Date",
    "week_starts_monday": true
  },
  "properties": {
    "Kanban Status": {
      "type": "select",
      "default": "Pre-Check",
      "options": {
        "Pre-Check": "gray",
        "Research": "blue",
        "Watchlist": "yellow",
        "Holding": "green",
        "Exited": "red"
      }
    },
    "Strategy Used": {
      "type": "select"
    }
  },
  "date_formats": ["%d-%m-%Y", "%d/%m/%Y", "%Y-%m-%d", "%d-%b-%Y", "%d-%b-%y", "%B %d, %Y",
                   "%d-%m-%Y %H:%M", "%d/%m/%Y %H:%M", "%Y-%m-%d %H:%M", "%B %d, %Y %I:%M %p"],
  "display_date_format": "%d-%b-%Y",
  "multi_select_separator": ",",
  "autofill_created_time": true
}
